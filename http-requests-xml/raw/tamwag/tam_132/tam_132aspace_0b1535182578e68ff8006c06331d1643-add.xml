<?xml version="1.0" encoding="UTF-8"?><add><doc><field name="author_teim">Jillian Cuellar, Peter Filardo, Stephanie Bennett, Margaret Fraser, Nancy Ng Tam, Hester Goodwin Stanley, Maggie Schreiner, Daniel Reisner, Michelle Dean, and Hanan Ohayon (March 2012). Edited to include accessioned materials, May 2014</field><field name="collection_sim">Communist Party of the United States of America Records</field><field name="collection_ssm">Communist Party of the United States of America Records</field><field name="collection_teim">Communist Party of the United States of America Records</field><field name="collection_unitid_ssm">TAM.132</field><field name="collection_unitid_teim">TAM.132</field><field name="component_children_bsi">false</field><field name="component_level_isim">2</field><field name="dao_sim">Online Access</field><field name="dao_ssm">People&#39;s World Archived Website</field><field name="dao_teim">People&#39;s World Archived Website</field><field name="date_range_sim">undated &amp; other</field><field name="ead_ssi">tam_132</field><field name="format_sim">Archival Object</field><field name="format_ssm">Archival Object</field><field name="heading_ssm">People&#39;s World Archived Website</field><field name="id">tam_132aspace_0b1535182578e68ff8006c06331d1643</field><field name="level_sim">file</field><field name="location_si">Box: Electronic Records</field><field name="location_ssm">Box: Electronic Records</field><field name="parent_ssi">aspace_ref10123</field><field name="parent_ssm">aspace_ref10123</field><field name="parent_unittitles_ssm">Series XIV: Archived Websites</field><field name="parent_unittitles_teim">Series XIV: Archived Websites</field><field name="ref_ssi">aspace_0b1535182578e68ff8006c06331d1643</field><field name="repository_sim">tamwag</field><field name="repository_ssi">tamwag</field><field name="repository_ssm">tamwag</field><field name="scopecontent_teim">People&#39;s World, established online in 2009, is a national news website that reports on workers&#39; rights, peace, equality, social and economic justice, democracy, civil liberties, women&#39;s rights, protection of the environment, and other topics. The website is affiliated with the Community Party USA and descended from the Daily Worker, the Communist Party&#39;s newspaper from 1924-1991. The website publishes articles and opinion pieces. The Spanish language edition of the website is called Mundo Popular. The website was redesigned in 2016.</field><field name="series_si">Series XIV: Archived Websites &gt;&gt; &lt;em&gt;People&#39;s World&lt;/em&gt; Archived Website</field><field name="series_sim">Series XIV: Archived Websites</field><field name="sort_ii">13454</field><field name="unitdate_normal_sim">2009-12-02/2009-12-02</field><field name="unitdate_normal_ssm">2009-12-02/2009-12-02</field><field name="unitdate_normal_teim">2009-12-02/2009-12-02</field><field name="unitdate_ssm">December 2009-ongoing</field><field name="unitdate_teim">December 2009-ongoing</field><field name="unitid_ssm">cuid32944</field><field name="unitid_ssm">/repositories/2/archival_objects/770874</field><field name="unitid_teim">cuid32944</field><field name="unitid_teim">/repositories/2/archival_objects/770874</field><field name="unittitle_ssm">&lt;em&gt;People&#39;s World&lt;/em&gt; Archived Website</field><field name="unittitle_teim">People&#39;s World Archived Website</field></doc></add>