<?xml version="1.0" encoding="UTF-8"?><add><doc><field name="author_teim">Peter Cherches, March - April 2007.</field><field name="collection_sim">James Beard Collection</field><field name="collection_ssm">James Beard Collection</field><field name="collection_teim">James Beard Collection</field><field name="collection_unitid_ssm">MSS.139</field><field name="collection_unitid_teim">MSS.139</field><field name="component_children_bsi">true</field><field name="component_level_isim">1</field><field name="date_range_sim">undated &amp; other</field><field name="ead_ssi">mss_139</field><field name="format_sim">Archival Series</field><field name="format_ssm">Archival Series</field><field name="heading_ssm">Series VI: José Wilson</field><field name="id">mss_139aspace_ref34</field><field name="level_sim">series</field><field name="ref_ssi">aspace_ref34</field><field name="repository_sim">fales</field><field name="repository_ssi">fales</field><field name="repository_ssm">fales</field><field name="scopecontent_teim">Materials relating to Wilson&#39;s working relationship and friendship with Beard. Wilson was a collaborator with Beard on cookbooks and newspaper and magazine columns. Included are notes to Beard and Emily Gilder (Beard&#39;s secretary), a typescript of a column, as well as Wilson&#39;s suicide note to Beard (she died in 1980), and Beard&#39;s obituary for Wilson.</field><field name="series_si">Series VI: José Wilson</field><field name="sort_ii">20</field><field name="unittitle_ssm">Series VI: José Wilson</field><field name="unittitle_teim">Series VI: José Wilson</field></doc></add>